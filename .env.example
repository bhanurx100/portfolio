# GEMINI_API_KEY: Optional — enables Builder Lab Mode B (AI interpretation).
# Without it, the Builder Lab uses the deterministic Mode A engine and
# everything still works. Used ONLY server-side (npm run server); never
# exposed to the browser.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
