  const totalOutflow = data.reduce((acc, curr) => acc + curr.outflow, 0);
  const totalNet = totalInflow - totalOutflow;
  const savingsPct = Math.round((totalNet / totalInflow) * 100);

  return (
    <div className={`p-2.5 sm:p-3 rounded-2xl border space-y-2.5 ${
