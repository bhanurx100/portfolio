                      top: `${hoveredCell.y - 8}px`,
                    }}
                  >
                    <div className="font-bold text-emerald-400">
                      {hoveredCell.count === 0
                        ? '0 contributions'
                        : `${hoveredCell.count} contribution${hoveredCell.count > 1 ? 's' : ''}`}
                    </div>
                    <div className="text-[10px] text-slate-400 mt-0.5">
                      {formatDisplayDate(hoveredCell.date)}
