              {/* Legend Strip */}
              <div className="flex flex-wrap items-center justify-between text-xs font-mono pt-1 text-slate-400">
                <div className="flex items-center gap-2">
                  <span className="w-2 h-2 rounded-full bg-emerald-500" />
