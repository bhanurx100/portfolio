<file path="src/components/common/SplitFinVisualCharts.tsx">
import React, { useState } from 'react';
import { 
  TrendingUp, ArrowUpRight, ArrowDownRight, 
  PieChart, DollarSign, Users, Zap, CheckCircle2, 
  Sparkles, RefreshCw, ShieldCheck, Layers, Orbit,
  Compass, Share2, ArrowRight, Lock
} from 'lucide-react';
import { motion, AnimatePresence } from 'motion/react';

// ============================================================================
// 1. SPLITFIN INTERACTIVE SVG DONUT CHART
// ============================================================================
export interface ExpenseCategory {
  id: string;
  name: string;
  amount: number;
  pct: number;
  color: string;
  hoverColor: string;
  icon?: string;
  itemsCount: number;
}

export const SPLITFIN_CATEGORIES: ExpenseCategory[] = [
  { id: 'dining', name: 'Dining & Outings', amount: 18600, pct: 42, color: '#10B981', hoverColor: '#059669', itemsCount: 14 },
  { id: 'stays', name: 'Stays & Rentals', amount: 13290, pct: 30, color: '#3B82F6', hoverColor: '#2563EB', itemsCount: 4 },
  { id: 'travel', name: 'Travel & Flights', amount: 7974, pct: 18, color: '#8B5CF6', hoverColor: '#7C3AED', itemsCount: 6 },
  { id: 'subs', name: 'Utilities & Subs', amount: 4436, pct: 10, color: '#F59E0B', hoverColor: '#D97706', itemsCount: 8 },
];

interface SplitFinDonutProps {
  categories?: ExpenseCategory[];
  size?: 'compact' | 'full';
  isDark?: boolean;
  onSelectCategory?: (cat: ExpenseCategory) => void;
}

export const SplitFinDonutChart: React.FC<SplitFinDonutProps> = ({
  categories = SPLITFIN_CATEGORIES,
  size = 'compact',
  isDark = true,
  onSelectCategory,
}) => {
  const [activeId, setActiveId] = useState<string>('dining');
  const activeCategory = categories.find(c => c.id === activeId) || categories[0];
  const totalAmount = categories.reduce((sum, c) => sum + c.amount, 0);

  // SVG Geometry calculations
  const dimension = size === 'compact' ? 128 : 170;
  const strokeWidth = size === 'compact' ? 15 : 20;
  const radius = (dimension - strokeWidth) / 2;
  const circumference = 2 * Math.PI * radius;
  const center = dimension / 2;

  let accumulatedPct = 0;

  return (
    <div className="flex flex-col items-center gap-3">
      {/* Visual Chart with Dynamic Center Label */}
      <div className="relative flex items-center justify-center" style={{ width: dimension, height: dimension }}>
        <svg
          width={dimension}
          height={dimension}
          viewBox={`0 0 ${dimension} ${dimension}`}
          className="transform -rotate-90"
        >
          {/* Track background ring */}
          <circle
            cx={center}
            cy={center}
            r={radius}
            fill="transparent"
            stroke={isDark ? '#1E293B' : '#E2E8F0'}
            strokeWidth={strokeWidth}
          />

          {/* Slices */}
          {categories.map((cat) => {
            const strokeDasharray = `${(cat.pct / 100) * circumference} ${circumference}`;
            const strokeDashoffset = -((accumulatedPct / 100) * circumference);
            accumulatedPct += cat.pct;
            const isSelected = activeId === cat.id;

            return (
              <circle
                key={cat.id}
                cx={center}
                cy={center}
                r={radius}
                fill="transparent"
                stroke={cat.color}
                strokeWidth={isSelected ? strokeWidth + 4 : strokeWidth}
                strokeDasharray={strokeDasharray}
                strokeDashoffset={strokeDashoffset}
                strokeLinecap="round"
                className="transition-all duration-300 cursor-pointer"
                style={{
                  opacity: activeId && !isSelected ? 0.45 : 1,
                  filter: isSelected ? `drop-shadow(0 0 6px ${cat.color}80)` : 'none',
                }}
                onMouseEnter={() => {
                  setActiveId(cat.id);
                  onSelectCategory && onSelectCategory(cat);
                }}
                onClick={() => {
                  setActiveId(cat.id);
                  onSelectCategory && onSelectCategory(cat);
                }}
              />
            );
          })}
        </svg>

        {/* Dynamic Center Metric Readout */}
        <div className="absolute inset-0 flex flex-col items-center justify-center text-center pointer-events-none px-2">
