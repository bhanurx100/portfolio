// ============================================================================
// 5. SPLITFIN BILL SPLITTER & SHARE CALCULATOR (REDESIGNED)
// ============================================================================
interface SplitFinRadialSplitOrbitProps {
  billTotal: number;
  onBillChange: (amt: number) => void;
  isDark?: boolean;
  onShareUpi?: () => void;
}

export const SplitFinRadialSplitOrbit: React.FC<SplitFinRadialSplitOrbitProps> = ({
  billTotal,
  onBillChange,
  isDark = true,
  onShareUpi,
}) => {
  const [payerId, setPayerId] = useState<string>('bhanu');
  const [copiedLink, setCopiedLink] = useState(false);

  // 4 Peers
  const peers = [
    { id: 'bhanu', name: 'You', code: 'BL', color: '#10B981' },
    { id: 'rohan', name: 'Rohan', code: 'RS', color: '#3B82F6' },
    { id: 'priya', name: 'Priya', code: 'PP', color: '#8B5CF6' },
    { id: 'aditya', name: 'Aditya', code: 'AV', color: '#F59E0B' },
  ];

  const perPersonShare = Math.round(billTotal / 4);
  const totalToCollect = billTotal - perPersonShare;

  const handleShare = () => {
    setCopiedLink(true);
    onShareUpi && onShareUpi();
    setTimeout(() => setCopiedLink(false), 2500);
  };

  const adjustBill = (delta: number) => {
    const next = Math.max(400, billTotal + delta);
    onBillChange(next);
  };

  return (
    <div className="space-y-2.5">
      {/* 1. BILL AMOUNT CARD */}
      <div className={`p-3 rounded-2xl border space-y-2.5 transition-colors ${
        isDark ? 'bg-slate-900/95 border-slate-800' : 'bg-white border-slate-200 shadow-xs'
      }`}>
        <div className="flex items-center justify-between">
          <div>
            <div className="flex items-center gap-1.5">
              <Users className="w-3.5 h-3.5 text-emerald-500" />
              <h4 className={`text-xs font-sans font-bold ${isDark ? 'text-white' : 'text-slate-900'}`}>
                Bill Split Calculator
              </h4>
            </div>
            <p className={`text-[10px] ${isDark ? 'text-slate-400' : 'text-slate-500'}`}>
              Fisherman&apos;s Wharf Dinner • 4 friends
            </p>
          </div>
          <span className="px-2 py-0.5 rounded-full text-[9px] font-semibold bg-emerald-500/10 text-emerald-500 border border-emerald-500/20">
            Equal 4-Way
          </span>
        </div>

        {/* Bill Counter with Steppers */}
        <div className={`p-2 rounded-xl border flex items-center justify-between ${
          isDark ? 'bg-slate-950/70 border-slate-800' : 'bg-slate-50 border-slate-200'
        }`}>
          <button
            onClick={() => adjustBill(-200)}
            className={`w-7 h-7 rounded-lg border text-sm font-bold flex items-center justify-center transition cursor-pointer active:scale-95 ${
              isDark ? 'bg-slate-800 border-slate-700 text-slate-200 hover:bg-slate-700' : 'bg-white border-slate-300 text-slate-700 hover:bg-slate-100'
            }`}
          >
            -
          </button>

          <div className="text-center">
            <div className={`text-2xl font-bold font-mono tracking-tight ${isDark ? 'text-white' : 'text-slate-900'}`}>
              ₹{billTotal.toLocaleString()}
            </div>
            <div className={`text-[9.5px] ${isDark ? 'text-slate-400' : 'text-slate-500'}`}>
              ₹{perPersonShare.toLocaleString()} per friend
            </div>
          </div>

          <button
            onClick={() => adjustBill(200)}
            className={`w-7 h-7 rounded-lg border text-sm font-bold flex items-center justify-center transition cursor-pointer active:scale-95 ${
              isDark ? 'bg-slate-800 border-slate-700 text-slate-200 hover:bg-slate-700' : 'bg-white border-slate-300 text-slate-700 hover:bg-slate-100'
            }`}
          >
            +
          </button>
        </div>

        {/* Quick Amount Presets */}
        <div className="flex items-center justify-between gap-1">
          {[2400, 3840, 6400, 9600, 14000].map(amt => (
            <button
              key={amt}
              onClick={() => onBillChange(amt)}
              className={`flex-1 py-1 rounded-lg text-[10px] font-mono font-semibold transition cursor-pointer ${
                billTotal === amt
                  ? 'bg-emerald-600 text-white shadow-xs'
                  : isDark ? 'bg-slate-800 text-slate-300 hover:bg-slate-700' : 'bg-slate-100 border border-slate-200 text-slate-700 hover:bg-slate-200'
              }`}
            >
              ₹{amt >= 1000 ? `${amt / 1000}k` : amt}
            </button>
          ))}
        </div>

        {/* Paid By Selector */}
        <div className="pt-1">
          <div className={`text-[10px] font-semibold mb-1.5 ${isDark ? 'text-slate-300' : 'text-slate-700'}`}>
            Who paid the bill?
          </div>
          <div className="grid grid-cols-4 gap-1.5">
            {peers.map((peer) => {
              const isSelected = payerId === peer.id;
              return (
                <button
                  key={peer.id}
                  onClick={() => setPayerId(peer.id)}
                  className={`py-1.5 px-1 rounded-xl border flex flex-col items-center text-center transition cursor-pointer ${
                    isSelected
                      ? isDark 
                        ? 'bg-emerald-950/40 border-emerald-500 text-white ring-1 ring-emerald-500/30' 
                        : 'bg-emerald-50 border-emerald-500 text-emerald-900 ring-1 ring-emerald-300'
                      : isDark ? 'bg-slate-950/50 border-slate-800 text-slate-400' : 'bg-slate-50 border-slate-200 text-slate-600'
                  }`}
                >
                  <div
                    className="w-5 h-5 rounded-full text-white font-bold text-[9px] flex items-center justify-center mb-0.5"
                    style={{ backgroundColor: peer.color }}
                  >
                    {peer.code}
                  </div>
                  <span className="text-[10px] font-semibold truncate max-w-full">{peer.name}</span>
                  <span className="text-[8px] opacity-75">{isSelected ? 'Payer' : 'Peer'}</span>
                </button>
              );
            })}
          </div>
        </div>
      </div>

      {/* 2. PEER BREAKDOWN CARDS */}
      <div className={`p-3 rounded-2xl border space-y-2 transition-colors ${
        isDark ? 'bg-slate-900/95 border-slate-800' : 'bg-white border-slate-200 shadow-xs'
      }`}>
        <div className={`text-[10.5px] font-semibold flex items-center justify-between ${
          isDark ? 'text-slate-300' : 'text-slate-700'
        }`}>
          <span>Split Breakdown (25% each)</span>
          <span className="text-[10px] text-slate-400">4 People</span>
        </div>

        <div className="space-y-1.5">
          {peers.map((peer) => {
            const isPayer = peer.id === payerId;
            return (
              <div
                key={peer.id}
                className={`p-2 rounded-xl border flex items-center justify-between ${
                  isPayer
                    ? isDark ? 'bg-emerald-950/20 border-emerald-500/40' : 'bg-emerald-50 border-emerald-300'
                    : isDark ? 'bg-slate-950/60 border-slate-800' : 'bg-slate-50 border-slate-200'
                }`}
              >
                <div className="flex items-center gap-2">
                  <div
                    className="w-7 h-7 rounded-full text-white font-bold text-[10px] flex items-center justify-center shrink-0"
                    style={{ backgroundColor: peer.color }}
                  >
                    {peer.code}
                  </div>
                  <div>
                    <div className="flex items-center gap-1.5">
                      <span className={`text-xs font-semibold ${isDark ? 'text-white' : 'text-slate-900'}`}>
                        {peer.name}
                      </span>
                      {isPayer && (
                        <span className="px-1.5 py-0.2 rounded-md text-[8.5px] font-bold bg-emerald-500/20 text-emerald-500">
                          Paid ₹{billTotal.toLocaleString()}
                        </span>
                      )}
                    </div>
                    <span className={`text-[9.5px] ${isDark ? 'text-slate-400' : 'text-slate-500'}`}>
                      {isPayer ? `Gets ₹${totalToCollect.toLocaleString()} back` : `Owes ₹${perPersonShare.toLocaleString()}`}
                    </span>
                  </div>
                </div>

                <div className="text-right">
                  <span className={`text-xs font-bold font-mono block ${
                    isPayer 
                      ? isDark ? 'text-emerald-400' : 'text-emerald-600'
                      : 'text-rose-500'
                  }`}>
                    {isPayer ? `+₹${totalToCollect.toLocaleString()}` : `-₹${perPersonShare.toLocaleString()}`}
                  </span>
                  <span className="text-[9px] text-slate-400">25% Share</span>
                </div>
              </div>
            );
          })}
        </div>

        {/* 1-Tap UPI Dispatch Button */}
        <button
          onClick={handleShare}
          className="w-full py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs flex items-center justify-center gap-1.5 shadow-xs transition active:scale-95 cursor-pointer mt-1"
        >
          {copiedLink ? (
            <>
              <CheckCircle2 className="w-3.5 h-3.5 text-white" />
              <span>✓ 3 UPI Payment Links Generated</span>
            </>
          ) : (
            <>
              <Share2 className="w-3.5 h-3.5 text-white" />
              <span>Request 3 Friends via UPI (₹{totalToCollect.toLocaleString()})</span>
            </>
          )}
        </button>
      </div>
    </div>
  );
};
